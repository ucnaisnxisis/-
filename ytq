// ==UserScript==
// @name         YouTube Android – traducere subtitrări în română
// @namespace    local.yt.mobile.ro
// @version      1.4
// @description  Pentru m.youtube.com: subtitrări → Traducere automată → Română. O singură încercare per videoclip.
// @match        https://m.youtube.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(() => {
  'use strict';

  const WAIT_FOR_MENU_MS = 7000;
  const POLL_MS = 250;

  /*
   * SELECTORI DE REZERVĂ — ADAUGĂ AICI TERMENI/SELECTORI NOI.
   *
   * Adaugă fiecare selector între ghilimele, separat prin virgulă.
   * Exemplu:
   * 'yt-list-item-view-model.ytListItemViewModelHost:nth-of-type(9)',
   *
   * Scriptul verifică textul elementului înainte să dea clic.
   */
  const LIST_ITEM_SELECTORS = [
    'yt-list-item-view-model.ytListItemViewModelHost:nth-of-type(8)',
    'yt-list-item-view-model.ytListItemViewModelHost:nth-of-type(10)'
    // Adaugă selectori noi aici, câte unul pe linie.
  ];

  const attemptedVideos = new Set();
  let running = false;

  const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

  function videoId() {
    return new URL(location.href).searchParams.get('v') || location.pathname;
  }

  function visible(el) {
    if (!el) return false;

    const rect = el.getBoundingClientRect();
    const style = getComputedStyle(el);

    return rect.width > 0 &&
      rect.height > 0 &&
      style.visibility !== 'hidden' &&
      style.display !== 'none';
  }

  function label(el) {
    return [
      el.innerText,
      el.getAttribute('aria-label'),
      el.getAttribute('title')
    ]
      .filter(Boolean)
      .join(' ')
      .trim()
      .toLowerCase();
  }

  function clickOnce(el) {
    if (!el || !visible(el)) return false;

    el.click();
    return true;
  }

  function findButton(matches) {
    const buttons = [...document.querySelectorAll(
      'button, [role="button"], .ytp-button'
    )].filter(visible);

    return buttons.find(el =>
      matches.some(test => test(label(el)))
    ) || null;
  }

  function findMenuItem(matches) {
    const items = [...document.querySelectorAll(
      '.ytp-menuitem, [role="menuitem"], [role="option"], yt-list-item-view-model'
    )].filter(visible);

    return items.find(el =>
      matches.some(test => test(label(el)))
    ) || null;
  }

  function findByFallbackSelectors(matches) {
    for (const selector of LIST_ITEM_SELECTORS) {
      try {
        const el = document.querySelector(selector);

        if (
          visible(el) &&
          matches.some(test => test(label(el)))
        ) {
          return el;
        }
      } catch (error) {
        console.warn('[YT RO] Selector invalid:', selector, error);
      }
    }

    return null;
  }

  async function waitFor(find, timeout = WAIT_FOR_MENU_MS) {
    const end = Date.now() + timeout;

    while (Date.now() < end) {
      const result = find();
      if (result) return result;

      await sleep(POLL_MS);
    }

    return null;
  }

  function scrollableAncestors(el) {
    const result = [];
    let node = el?.parentElement;

    while (node && node !== document.body) {
      const style = getComputedStyle(node);

      if (
        /(auto|scroll)/.test(style.overflowY) &&
        node.scrollHeight > node.clientHeight
      ) {
        result.push(node);
      }

      node = node.parentElement;
    }

    return result;
  }

  async function findAndScrollToRomanian() {
    const isRomanian = el => {
      const text = label(el);

      return text === 'română' ||
        text === 'romana' ||
        text === 'romanian' ||
        text.includes('română') ||
        text.includes('romana') ||
        text.includes('romanian');
    };

    const end = Date.now() + WAIT_FOR_MENU_MS;
    let steps = 0;

    while (Date.now() < end && steps < 24) {
      const candidates = [...document.querySelectorAll(
        'yt-list-item-view-model, [role="menuitem"], [role="option"], button'
      )];

      const romanian = candidates.find(el =>
        visible(el) && isRomanian(el)
      );

      if (romanian) {
        romanian.scrollIntoView({
          block: 'center',
          behavior: 'smooth'
        });

        await sleep(250);
        return clickOnce(romanian);
      }

      // Încearcă selectorii configurați pentru a găsi panoul derulabil.
      let panelItem = null;

      for (const selector of LIST_ITEM_SELECTORS) {
        try {
          const el = document.querySelector(selector);

          if (visible(el) && scrollableAncestors(el).length) {
            panelItem = el;
            break;
          }
        } catch (error) {
          console.warn('[YT RO] Selector invalid:', selector, error);
        }
      }

      // Rezervă: caută un element de meniu aflat într-un panou derulabil.
      if (!panelItem) {
        panelItem = candidates.find(el =>
          visible(el) && scrollableAncestors(el).length
        );
      }

      const scrollTargets = scrollableAncestors(panelItem);

      if (scrollTargets.length) {
        for (const target of scrollTargets) {
          target.scrollTop += Math.max(
            250,
            Math.floor(target.clientHeight * 0.7)
          );
        }
      } else {
        window.scrollBy(
          0,
          Math.max(250, Math.floor(window.innerHeight * 0.7))
        );
      }

      steps++;
      await sleep(POLL_MS);
    }

    return false;
  }

  async function runForVideo(id) {
    if (running || attemptedVideos.has(id)) return;

    running = true;
    attemptedVideos.add(id);

    try {
      await sleep(1800);
      if (id !== videoId()) return;

      const cc = findButton([
        t => t.includes('captions') ||
             t.includes('subtitles') ||
             t.includes('subtitr')
      ]);

      if (cc) {
        const pressed = cc.getAttribute('aria-pressed');
        const isOn = pressed === 'true' ||
          /\b(on|activat|pornit)\b/i.test(label(cc));

        if (!isOn) clickOnce(cc);
        await sleep(500);
      }

      if (id !== videoId()) return;

      const settings = findButton([
        t => t.includes('settings') ||
             t.includes('setări') ||
             t.includes('setari')
      ]);

      if (!clickOnce(settings)) return;

      const subtitles = await waitFor(() =>
        findMenuItem([
          t => t.includes('subtitles') ||
               t.includes('subtitr') ||
               t.includes('captions')
        ])
      );

      if (!clickOnce(subtitles)) return;

      const autoTranslateMatches = [
        t => t.includes('auto-translate'),
        t => t.includes('translate automatically'),
        t => t.includes('traducere automată'),
        t => t.includes('traduce automat')
      ];

      const autoTranslate = await waitFor(() =>
        findByFallbackSelectors(autoTranslateMatches) ||
        findMenuItem(autoTranslateMatches)
      );

      if (!clickOnce(autoTranslate)) return;

      await sleep(350);
      await findAndScrollToRomanian();
    } finally {
      running = false;
    }
  }

  function checkVideo() {
    const id = videoId();

    if (id && !attemptedVideos.has(id)) {
      runForVideo(id);
    }
  }

  const originalPushState = history.pushState;

  history.pushState = function (...args) {
    const result = originalPushState.apply(this, args);
    setTimeout(checkVideo, 1200);
    return result;
  };

  const originalReplaceState = history.replaceState;

  history.replaceState = function (...args) {
    const result = originalReplaceState.apply(this, args);
    setTimeout(checkVideo, 1200);
    return result;
  };

  window.addEventListener('popstate', () => {
    setTimeout(checkVideo, 1200);
  });

  setTimeout(checkVideo, 1800);
})();
