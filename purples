// @namespace    local.purplemode
// @version      4.4.1
// @description  Alege automat tema mov în funcție de site.
// @match        *://*/*
// @run-at       document-start
// @grant        none
// @require      https://cdn.jsdelivr.net/npm/darkreader@4.9.96/darkreader.min.js
// ==/UserScript==

