// ==UserScript==
// @name         Avertizare site 18+ cu audio și GIF
// @namespace    local
// @version      1.2
// @description  Afișează un avertisment cu audio pe paginile recunoscute ca 18+
// @match        *://*/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(() => {
    'use strict';

    const AUDIO_URL =
        'https://ia600706.us.archive.org/32/items/its-time-to-stop_20261124/its%20time%20to%20stop.mp3';

    const GIF_URL =
        'https://ia600706.us.archive.org/32/items/its-time-to-stop_20261124/fff.gif';

    // Pornește doar dacă adresa sau titlul paginii conține unul dintre acești termeni.
    const textPagina = `${location.hostname} ${document.title}`.toLowerCase();
    const site18Plus = /\b(porn|porno|pornography|xxx|adult|sex)\b|18\+/i.test(textPagina);

    if (!site18Plus) return;

    const overlay = document.createElement('div');
    overlay.style.cssText = `
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 16px;
        background: rgba(0, 0, 0, 0.88);
        text-align: center;
    `;

    const titlu = document.createElement('div');
    titlu.textContent = 'Stop! Site 18+, nu este recomandat minorilor.';
    titlu.style.cssText = `
        color: red;
        font: bold 22px/1.3 sans-serif;
        text-shadow: 0 1px 3px #000;
    `;

    const imagine = document.createElement('img');
    imagine.src = GIF_URL;
    imagine.alt = 'Avertisment';
    imagine.style.cssText = `
        max-width: min(80vw, 360px);
        max-height: 55vh;
        object-fit: contain;
    `;

    const audio = new Audio(AUDIO_URL);
    audio.preload = 'auto';

    const buton = document.createElement('button');
    buton.textContent = 'Pornește audio';
    buton.style.cssText = 'padding: 10px 16px; font-size: 16px;';

    overlay.append(titlu, imagine, buton);
    document.documentElement.appendChild(overlay);

    let terminat = false;

    function inchide() {
        if (terminat) return;
        terminat = true;
        audio.pause();
        overlay.remove();
    }

    // Închide totul cu aproximativ 0,5 secunde înainte de finalul audio-ului.
    audio.addEventListener('timeupdate', () => {
        if (
            Number.isFinite(audio.duration) &&
            audio.duration - audio.currentTime <= 0.5
        ) {
            inchide();
        }
    });

    // Rezervă: închide overlay-ul când audio-ul se termină.
    audio.addEventListener('ended', inchide, { once: true });

    buton.addEventListener('click', () => {
        audio.play()
            .then(() => buton.remove())
            .catch(() => {
                buton.textContent = 'Redarea nu a pornit — încearcă din nou';
            });
    });

    // Încearcă redarea automată; unele browsere cer mai întâi o atingere sau un clic.
    audio.play()
        .then(() => buton.remove())
        .catch(() => {
            buton.hidden = false;
        });
})();
