// @resource     mikuAdore https://media.tenor.com/ibw_yNLcfrcAAAAm/hatsune-miku-world-is-mine.webp
// @run-at       document-idle
// @grant        GM_getResourceURL
// ==/UserScript==

(() => {
  if (!document.body || document.getElementById("miku-chat-overlay")) return;

  const fallback = "https://img1.picmix.com/output/stamp/normal/3/4/9/7/1997943_57e8b.gif";

  function getResource(name, url) {
    try {
      return GM_getResourceURL(name) || url;
    } catch {
      return url;
    }
  }

  const assets = {
    default: getResource("mikuDefault", fallback),
    dance: getResource("mikuDance", "https://media.tenor.com/s2kXfVOep1IAAAAm/miku-hatsune-miku.webp"),
    shoot: getResource("mikuShoot", "https://media.tenor.com/yz1hrVPqABEAAAAm/miku-shooting-no-background.webp"),
    adore: getResource("mikuAdore", "https://media.tenor.com/ibw_yNLcfrcAAAAm/hatsune-miku-world-is-mine.webp")
  };

  const extraAvatars = [
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/122-1225205_hatsune-miku-transparent-clipart-hatsune-miku-sticker-png-1092602785.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/28829-1-hatsune-miku-transparent-image-2091593626.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/28873-6-hatsune-miku-transparent-picture-930409083.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Anime-Miku-Hatsune-PNG-Image-Background-3049271566.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Blue-Hair-Hatsune-Miku-Free-PNG-Image-2431313334.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Cute-Hatsune-Miku-PNG-High-Quality-Image-891324334.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Cute-Hatsune-Miku-PNG-Pic-1315483572.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Cute-Hatsune-Miku-Transparent-Image-3234163740.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Cute-Miku-Hatsune-PNG-Background-Image-527419469.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Hatsune-Miku-PNG-Free-Image-986555811.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Hatsune-Miku-Transparent-160764061.png",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/Hatsune-Miku-Transparent-Background-PNG-213x279-2277182250.png",
    "https://ia601400.us.archive.org/27/items/cute-hatsune-miku-png-pic-1315483572/angai313-miku.gif",
    "https://ia601400.us.archive.org/27/items/cute-hatsune-miku-png-pic-1315483572/hatsune-miku-anime.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/hatsune-miku-fnf.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/hatsune-miku-voc.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/hatsune-miku.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/miku-%3Dpunch-hatsune-miku.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/miku-licking.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/miku-vocaloid.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/miku.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/miku0.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/nurse-miku.gif",
    "https://archive.org/download/cute-hatsune-miku-png-pic-1315483572/%E5%88%9D%E9%9F%B3%E3%83%9F%E3%82%AF-hatsune-miku.gif"
  ];

  const host = document.createElement("div");
  host.id = "miku-chat-overlay";
  const shadow = host.attachShadow({ mode: "open" });

  const style = document.createElement("style");
  style.textContent = `
    :host {
      all: initial;
      position: fixed;
      inset: 0;
      display: block;
      overflow: hidden;
      z-index: 2147483647;
      pointer-events: none;
      font-family: system-ui, sans-serif;
    }

    #stage {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    #avatar-frame {
      position: absolute;
      left: 0;
      top: 0;
      width: clamp(190px, 27vw, 320px);
      height: clamp(190px, 27vw, 320px);
      transition: left 2s ease, top 2s ease;
      will-change: left, top;
    }

    #avatar {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 4px 6px #0005);
      user-select: none;
      -webkit-user-drag: none;
      opacity: 1;
      transition: opacity .25s ease;
    }

    #avatar.fade { opacity: 0; }

    #speech {
      position: absolute;
      display: none;
      max-width: min(280px, 65vw);
      padding: 10px 14px;
      border: 2px solid var(--miku-text, #d52e91);
      border-radius: 18px;
      background: var(--miku-bg, #ffe6f4);
      color: var(--miku-text, #d52e91);
      box-shadow: 0 4px 14px #0003;
      font-size: 15px;
      line-height: 1.35;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
      transform: translate(-50%, -100%);
      z-index: 2;
    }

    .particle {
      position: absolute;
      top: -50px;
      line-height: 1;
      animation: fall var(--duration, 5s) linear forwards;
      filter: drop-shadow(0 2px 2px #0003);
    }

    @keyframes fall {
      from { transform: translateY(-40px) rotate(0deg); }
      to { transform: translateY(110vh) rotate(540deg); }
    }

    .float-emoji {
      position: absolute;
      font-size: 26px;
      line-height: 1;
      animation: float-up 1.8s ease-out forwards;
    }

    @keyframes float-up {
      0% { opacity: 0; transform: translateY(0) scale(.65); }
      15% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-95px) scale(1.3); }
    }

    #chat {
      position: fixed;
      left: 16px;
      bottom: 16px;
      width: min(390px, calc(100vw - 32px));
      height: min(540px, calc(100vh - 32px));
      display: flex;
      flex-direction: column;
      overflow: hidden;
      isolation: isolate;
      border: 1px solid #d8c5ee;
      border-radius: 16px;
      background: #ffffffed;
      box-shadow: 0 8px 30px #0003;
      pointer-events: auto;
      z-index: 10;
      backdrop-filter: blur(8px);
    }

    #header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 10px 12px;
      background: #f2e7ff;
      color: #563478;
      font-size: 14px;
      font-weight: 700;
    }

    #header-actions, #tools {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .small-button, #send, #file-button, #restore-button {
      border: 0;
      border-radius: 9px;
      padding: 7px 9px;
      background: #8d55bd;
      color: white;
      cursor: pointer;
      font: 13px system-ui, sans-serif;
    }

    .small-button {
      background: #ffffffc9;
      color: #563478;
    }

    #settings {
      display: none;
      padding: 8px 10px;
      border-bottom: 1px solid #eadff2;
      background: white;
    }

    #settings.open { display: block; }

    .color-row {
      display: grid;
      grid-template-columns: 1fr 34px 1fr 34px;
      align-items: center;
      gap: 6px;
      margin: 5px 0;
      font-size: 12px;
      color: #49365b;
    }

    .color-row input {
      width: 32px;
      height: 26px;
      padding: 1px;
      border: 1px solid #cbb5df;
      border-radius: 6px;
    }

    #messages {
      flex: 1;
      overflow-y: auto;
      padding: 10px;
    }

    .message {
      width: fit-content;
      max-width: 88%;
      margin: 7px 0;
      padding: 8px 11px;
      border-radius: 14px;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
      font-size: 14px;
      line-height: 1.35;
    }

    .message.user {
      margin-left: auto;
      border-bottom-right-radius: 4px;
      background: var(--user-bg, #eee2ff);
      color: var(--user-text, #7138ad);
    }

    .message.miku {
      margin-right: auto;
      border-bottom-left-radius: 4px;
      background: var(--miku-bg, #ffe6f4);
      color: var(--miku-text, #d52e91);
    }

    .attachment {
      display: block;
      max-width: 100%;
      max-height: 220px;
      margin-top: 6px;
      border-radius: 8px;
    }

    #form {
      display: flex;
      gap: 7px;
      padding: 9px;
      border-top: 1px solid #eadff2;
    }

    #input {
      flex: 1;
      min-width: 0;
      border: 1px solid #cbb5df;
      border-radius: 10px;
      padding: 9px 10px;
      outline: none;
      color: #222;
      background: white;
      font: 16px system-ui, sans-serif;
      pointer-events: auto;
      user-select: text;
      -webkit-user-select: text;
      touch-action: manipulation;
    }

    #input:focus {
      border-color: #8d55bd;
      box-shadow: 0 0 0 2px #8d55bd33;
    }

    #tools { padding: 0 9px 9px; }

    #identity {
      border: 1px solid #cbb5df;
      border-radius: 8px;
      padding: 6px;
      color: #49365b;
      background: white;
    }

    #file-input { display: none; }

    #restore-button {
      position: fixed;
      left: 16px;
      bottom: 16px;
      display: none;
      pointer-events: auto;
      z-index: 11;
    }

    @media (prefers-reduced-motion: reduce) {
      #avatar-frame { transition: none; }
      .particle, .float-emoji { animation-duration: .01ms; }
    }
  `;

  const stage = document.createElement("div");
  stage.id = "stage";

  const avatarFrame = document.createElement("div");
  avatarFrame.id = "avatar-frame";

  const avatar = document.createElement("img");
  avatar.id = "avatar";
  avatar.alt = "Hatsune Miku";
  avatar.draggable = false;
  avatar.src = assets.default;
  avatarFrame.appendChild(avatar);

  const speech = document.createElement("div");
  speech.id = "speech";
  speech.setAttribute("role", "status");
  stage.append(avatarFrame, speech);

  const chat = document.createElement("section");
  chat.id = "chat";

  const header = document.createElement("div");
  header.id = "header";

  const title = document.createElement("span");
  title.textContent = "Chat cu Hatsune Miku";

  const actions = document.createElement("div");
  actions.id = "header-actions";

  function makeButton(label, className = "small-button") {
    const button = document.createElement("button");
    button.type = "button";
    button.className = className;
    button.textContent = label;
    return button;
  }

  const infoButton = makeButton("Info");
  const settingsButton = makeButton("Culori");
  const hideButton = makeButton("Ascunde");

  actions.append(infoButton, settingsButton, hideButton);
  header.append(title, actions);

  const settings = document.createElement("div");
  settings.id = "settings";

  function makeColorRow(label, textVar, textDefault, bgVar, bgDefault) {
    const row = document.createElement("div");
    row.className = "color-row";

    const textLabel = document.createElement("span");
    textLabel.textContent = `${label} — text`;

    const textPicker = document.createElement("input");
    textPicker.type = "color";
    textPicker.value = textDefault;
    textPicker.addEventListener("input", () => {
      host.style.setProperty(textVar, textPicker.value);
    });

    const bgLabel = document.createElement("span");
    bgLabel.textContent = "fundal";

    const bgPicker = document.createElement("input");
    bgPicker.type = "color";
    bgPicker.value = bgDefault;
    bgPicker.addEventListener("input", () => {
      host.style.setProperty(bgVar, bgPicker.value);
    });

    row.append(textLabel, textPicker, bgLabel, bgPicker);
    return row;
  }

  settings.append(
    makeColorRow("Tu", "--user-text", "#7138ad", "--user-bg", "#eee2ff"),
    makeColorRow("Miku", "--miku-text", "#d52e91", "--miku-bg", "#ffe6f4")
  );

  const messages = document.createElement("div");
  messages.id = "messages";
  messages.setAttribute("aria-live", "polite");

  const form = document.createElement("form");
  form.id = "form";

  const input = document.createElement("input");
  input.id = "input";
  input.type = "text";
  input.autocomplete = "off";
  input.autocapitalize = "off";
  input.spellcheck = false;
  input.placeholder = "Scrie un mesaj sau o comandă…";
  input.setAttribute("aria-label", "Mesaj pentru Miku");

  const send = makeButton("Trimite", "");
  send.id = "send";
  send.type = "submit";

  form.append(input, send);

  const tools = document.createElement("div");
  tools.id = "tools";

  const identity = document.createElement("select");
  identity.id = "identity";
  identity.setAttribute("aria-label", "Identitatea atașamentului");
  identity.add(new Option("Atașament: Tu", "user"));
  identity.add(new Option("Atașament: Miku", "miku"));

  const fileButton = makeButton("Atașează fișier", "");
  fileButton.id = "file-button";

  const fileInput = document.createElement("input");
  fileInput.id = "file-input";
  fileInput.type = "file";
  fileInput.multiple = true;
  fileInput.accept = "image/*,.txt,.pdf,.json,.csv,.md";

  tools.append(identity, fileButton, fileInput);
  chat.append(header, settings, messages, form, tools);

  const restore = makeButton("Deschide chatul", "");
  restore.id = "restore-button";

  shadow.append(style, stage, chat, restore);
  document.body.appendChild(host);

  const history = [];
  const rainTimers = new Map();
  let moving = true;
  let reversed = false;
  let speechUntil = 0;
  let speechFrame = 0;
  let avatarIndex = -1;

  function focusInput() {
    if (chat.style.display !== "none") {
      try {
        input.focus({ preventScroll: true });
      } catch {
        input.focus();
      }
    }
  }

  // Împiedică pagina din spate să trateze tastele scrise în câmp ca scurtături.
  function shieldTyping(event) {
    const path = typeof event.composedPath === "function" ? event.composedPath() : [];
    if (path.includes(input) || event.target === input) {
      event.stopPropagation();
    }
  }

  for (const eventName of ["keydown", "keyup", "keypress", "beforeinput", "input"]) {
    input.addEventListener(eventName, shieldTyping);
  }

  input.addEventListener("pointerdown", event => event.stopPropagation());
  input.addEventListener("click", event => event.stopPropagation());
  input.addEventListener("focus", () => {
    input.style.userSelect = "text";
  });

  function renderMessages() {
    messages.replaceChildren();

    for (const item of history) {
      const role = reversed
        ? (item.role === "user" ? "miku" : "user")
        : item.role;

      const bubble = document.createElement("div");
      bubble.className = `message ${role}`;
      bubble.textContent = item.text;

      if (item.file) {
        if (item.file.type.startsWith("image/") && item.file.url) {
          const image = document.createElement("img");
          image.className = "attachment";
          image.alt = item.file.name;
          image.src = item.file.url;
          bubble.appendChild(image);
        } else {
          const fileLabel = document.createElement("div");
          fileLabel.textContent = `📎 ${item.file.name} (${item.file.sizeLabel})`;
          bubble.appendChild(fileLabel);
        }
      }

      messages.appendChild(bubble);
    }

    messages.scrollTop = messages.scrollHeight;
  }

  function addMessage(role, text, file = null) {
    history.push({ role, text, file });
    renderMessages();
  }

  function placeAvatar(x, y) {
    const maxX = Math.max(0, innerWidth - avatarFrame.offsetWidth);
    const maxY = Math.max(0, innerHeight - avatarFrame.offsetHeight);
    avatarFrame.style.left = `${Math.max(0, Math.min(x, maxX))}px`;
    avatarFrame.style.top = `${Math.max(0, Math.min(y, maxY))}px`;
  }

  function moveRandomly() {
    if (!moving) return;

    const maxX = Math.max(0, innerWidth - avatarFrame.offsetWidth);
    const maxY = Math.max(0, innerHeight - avatarFrame.offsetHeight);
    const oldX = parseFloat(avatarFrame.style.left) || 0;
    const nextX = Math.random() * maxX;

    avatar.style.transform = nextX < oldX ? "scaleX(-1)" : "scaleX(1)";
    placeAvatar(nextX, Math.random() * maxY);
  }

  function moveDirection(direction) {
    moving = false;

    const step = Math.max(90, Math.min(innerWidth, innerHeight) * 0.22);
    let x = parseFloat(avatarFrame.style.left) || 0;
    let y = parseFloat(avatarFrame.style.top) || 0;

    if (direction === "left") {
      x -= step;
      avatar.style.transform = "scaleX(-1)";
    } else if (direction === "right") {
      x += step;
      avatar.style.transform = "scaleX(1)";
    } else if (direction === "up") {
      y -= step;
    } else if (direction === "down") {
      y += step;
    }

    placeAvatar(x, y);
  }

  function followSpeech() {
    if (performance.now() < speechUntil && speech.style.display === "block") {
      const rect = avatarFrame.getBoundingClientRect();
      speech.style.left = `${Math.max(100, Math.min(innerWidth - 100, rect.left + rect.width / 2))}px`;
      speech.style.top = `${Math.max(85, rect.top - 8)}px`;
      speechFrame = requestAnimationFrame(followSpeech);
    } else {
      speech.style.display = "none";
      speechFrame = 0;
    }
  }

  function showSpeech(text) {
    speech.textContent = text;
    speech.style.display = "block";
    speechUntil = performance.now() + 5000;

    if (speechFrame) cancelAnimationFrame(speechFrame);
    speechFrame = requestAnimationFrame(followSpeech);
  }

  function showEmojis(list) {
    const rect = avatarFrame.getBoundingClientRect();

    for (let i = 0; i < 7; i++) {
      const item = document.createElement("span");
      item.className = "float-emoji";
      item.textContent = list[i % list.length];
      item.style.left = `${rect.left + rect.width * (0.2 + Math.random() * 0.6)}px`;
      item.style.top = `${rect.top + rect.height * (0.2 + Math.random() * 0.5)}px`;
      item.style.animationDelay = `${Math.random() * 0.3}s`;
      stage.appendChild(item);
      item.addEventListener("animationend", () => item.remove(), { once: true });
    }
  }

  function setAvatar(source, index = -1) {
    const next = assets[source] || source || assets.default;
    const probe = new Image();

    probe.onload = () => {
      avatar.classList.add("fade");

      setTimeout(() => {
        avatar.src = next;
        avatar.alt = index >= 0 ? `Hatsune Miku — poza ${index + 1}` : "Hatsune Miku";
        avatar.classList.remove("fade");
        if (index >= 0) avatarIndex = index;
      }, 180);
    };

    probe.onerror = () => {
      reply("Imaginea nu s-a încărcat. Verifică dacă linkul mai funcționează.");
    };

    probe.src = next;
  }

  function reply(text, options = {}) {
    addMessage("miku", text);
    showSpeech(text);

    if (options.avatar) setAvatar(options.avatar);
    if (options.emojis) showEmojis(options.emojis);
  }

  function startRain(name, emojis) {
    if (rainTimers.has(name)) {
      reply(`Ploaia ${name} este deja pornită.`);
      return;
    }

    const timer = setInterval(() => {
      for (let i = 0; i < 5; i++) {
        const particle = document.createElement("span");
        particle.className = "particle";
        particle.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        particle.style.left = `${Math.random() * 100}vw`;
        particle.style.fontSize = `${20 + Math.random() * 24}px`;
        particle.style.setProperty("--duration", `${3.5 + Math.random() * 3}s`);
        stage.appendChild(particle);
        particle.addEventListener("animationend", () => particle.remove(), { once: true });
      }
    }, 250);

    rainTimers.set(name, timer);
    reply(`A început ploaia ${name}!`);
  }

  function stopRain(name) {
    const timer = rainTimers.get(name);

    if (!timer) {
      reply(`Ploaia ${name} nu este pornită.`);
      return;
    }

    clearInterval(timer);
    rainTimers.delete(name);
    reply(`Am oprit ploaia ${name}.`);
  }

  function showHelp() {
    reply(
      "COMENZI DISPONIBILE\n" +
      "• miku poza 1–24 — schimbă avatarul\n" +
      "• miku urmatoarea / miku anterioara — schimbă poza\n" +
      "• miku normal / revino — avatarul implicit\n" +
      "• mergi — pornește plimbarea; stop — oprește mișcarea\n" +
      "• miku stai la stanga / dreapta / in sus / in jos\n" +
      "• danseaza / danseaza kawaii / adora\n" +
      "• ploaie de inimi — stop inimi\n" +
      "• ploaie poop — stop poop\n" +
      "• ploaie de culori — stop culori\n" +
      "• stop toate ploile — oprește toate animațiile de ploaie\n" +
      "• q mesaj — Miku repetă mesajul\n" +
      "• w — inversează etichetele mesajelor\n" +
      "• sterge-tot — șterge conversația\n" +
      "Poți atașa imagini sau fișiere cu butonul de jos; rămân locale în pagină."
    );
  }

  function normalize(text) {
    return text
      .trim()
      .toLocaleLowerCase("ro")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function handleMessage(raw) {
    const text = raw.trim();
    if (!text) return;

    const lower = normalize(text);

    if (lower === "info" || lower === "ajutor" || lower === "comenzi") {
      addMessage("user", text);
      showHelp();
      return;
    }

    const imageCommand = lower.match(/^miku poza\s+(\d{1,2})$/);
    if (imageCommand) {
      const index = Number(imageCommand[1]) - 1;
      addMessage("user", text);

      if (index < 0 || index >= extraAvatars.length) {
        reply(`Alege un număr de la 1 la ${extraAvatars.length}.`);
      } else {
        setAvatar(extraAvatars[index], index);
      }
      return;
    }

    if (lower === "miku urmatoarea" || lower === "miku urmatoarea poza") {
      addMessage("user", text);
      const index = (avatarIndex + 1) % extraAvatars.length;
      setAvatar(extraAvatars[index], index);
      return;
    }

    if (lower === "miku anterioara" || lower === "miku poza anterioara") {
      addMessage("user", text);
      const index = (avatarIndex <= 0 ? extraAvatars.length : avatarIndex) - 1;
      setAvatar(extraAvatars[index], index);
      return;
    }

    if (lower === "sterge-tot") {
      history.length = 0;
      renderMessages();
      speech.style.display = "none";
      return;
    }

    if (lower === "w") {
      reversed = !reversed;
      renderMessages();
      return;
    }

    if (lower.startsWith("q ")) {
      addMessage("user", text);
      const echo = text.slice(2).trim();
      if (echo) reply(echo);
      return;
    }

    if (lower === "ploaie de inimi" || lower === "ploaie inimi") {
      addMessage("user", text);
      startRain("inimi", ["💖", "💗", "💘", "💕", "❤️"]);
      return;
    }

    if (lower === "stop inimi") {
      addMessage("user", text);
      stopRain("inimi");
      return;
    }

    if (lower === "ploaie poop" || lower === "ploaie de poop") {
      addMessage("user", text);
      startRain("poop", ["💩"]);
      return;
    }

    if (lower === "stop poop") {
      addMessage("user", text);
      stopRain("poop");
      return;
    }

    if (lower === "ploaie de culori" || lower === "ploaie culori") {
      addMessage("user", text);
      startRain("culori", ["🔴", "🟠", "🟡", "🟢", "🔵", "🟣", "🟤"]);
      return;
    }

    if (lower === "stop culori") {
      addMessage("user", text);
      stopRain("culori");
      return;
    }

    if (lower === "stop toate ploile") {
      addMessage("user", text);

      for (const timer of rainTimers.values()) {
        clearInterval(timer);
      }
      rainTimers.clear();

      reply("Am oprit toate ploile.");
      return;
    }

    if (lower === "mergi") {
      moving = true;
      addMessage("user", text);
      reply("Am pornit la plimbare!");
      moveRandomly();
      return;
    }

    if (lower === "stop" || lower === "stop nu mai merge") {
      moving = false;
      addMessage("user", text);
      reply("M-am oprit.");
      return;
    }

    const directions = [
      [/^miku stai la stanga$/, "left", "Mă deplasez spre stânga."],
      [/^miku stai la dreapta$/, "right", "Mă deplasez spre dreapta."],
      [/^miku stai in sus$/, "up", "Mă deplasez în sus."],
      [/^miku stai in jos$/, "down", "Mă deplasez în jos."]
    ];

    for (const [pattern, direction, answer] of directions) {
      if (pattern.test(lower)) {
        addMessage("user", text);
        moveDirection(direction);
        reply(answer);
        return;
      }
    }

    if (lower.includes("danseaza kawaii")) {
      addMessage("user", text);
      reply("Dans kawaii! ✨", {
        avatar: "dance",
        emojis: ["✨", "🎵", "💫"]
      });
      return;
    }

    if (lower.includes("danseaza")) {
      addMessage("user", text);
      reply("Hai să dansăm! 🎵", {
        avatar: "dance",
        emojis: ["🎵", "🎶", "✨"]
      });
      return;
    }

    if (lower.includes("trage cu arma") || lower.includes("miku trage")) {
      addMessage("user", text);
      reply("Animație cu efect de acțiune. 💥", {
        avatar: "shoot",
        emojis: ["💥", "✨"]
      });
      return;
    }

    if (lower.includes("adora")) {
      addMessage("user", text);
      reply("Ce frumos! ✨", {
        avatar: "adore",
        emojis: ["✨", "💖", "⭐"]
      });
      return;
    }

    if (lower.includes("miku normal") || lower === "revino") {
      addMessage("user", text);
      setAvatar(assets.default);
      return;
    }

    addMessage("user", text);

    if (lower.includes("te iubesc")) {
      reply("Mulțumesc, ce mesaj drăguț!", {
        emojis: ["💖", "✨", "💖"]
      });
    } else if (lower.includes("salut") || lower.includes("buna")) {
      reply("Bună! 😊");
    } else if (lower.includes("ce faci")) {
      reply("Mă plimb pe ecran și citesc mesajele tale! 🎵");
    } else {
      reply("Am primit mesajul tău! Scrie „info” ca să vezi comenzile. ✨");
    }
  }

  form.addEventListener("submit", event => {
    event.preventDefault();
    event.stopPropagation();

    const value = input.value;
    input.value = "";
    handleMessage(value);
    focusInput();
  });

  // Previne scurtăturile paginii din spate când interacționezi cu chatul.
  chat.addEventListener("keydown", event => {
    event.stopPropagation();

    if (event.key === "Enter" && event.target === input && !event.isComposing) {
      event.preventDefault();
      form.requestSubmit();
    }
  }, true);

  chat.addEventListener("keyup", event => event.stopPropagation(), true);
  chat.addEventListener("keypress", event => event.stopPropagation(), true);
  chat.addEventListener("beforeinput", event => event.stopPropagation(), true);
  chat.addEventListener("input", event => event.stopPropagation(), true);

  chat.addEventListener("pointerdown", event => {
    event.stopPropagation();
  }, true);

  input.addEventListener("blur", () => {
    if (chat.matches(":hover") && chat.style.display !== "none") {
      setTimeout(focusInput, 0);
    }
  });

  infoButton.addEventListener("click", () => {
    showHelp();
    focusInput();
  });

  settingsButton.addEventListener("click", () => {
    settings.classList.toggle("open");
    focusInput();
  });

  hideButton.addEventListener("click", () => {
    chat.style.display = "none";
    restore.style.display = "block";
  });

  restore.addEventListener("click", () => {
    chat.style.display = "flex";
    restore.style.display = "none";
    focusInput();
  });

  fileButton.addEventListener("click", () => fileInput.click());

  fileInput.addEventListener("change", () => {
    for (const file of fileInput.files || []) {
      const role = identity.value;
      const url = file.type.startsWith("image/")
        ? URL.createObjectURL(file)
        : null;

      const sizeLabel = file.size < 1024 * 1024
        ? `${Math.max(1, Math.round(file.size / 1024))} KB`
        : `${(file.size / (1024 * 1024)).toFixed(1)} MB`;

      addMessage(
        role,
        role === "user"
          ? `Am atașat: ${file.name}`
          : `Miku a atașat: ${file.name}`,
        { name: file.name, type: file.type || "", sizeLabel, url }
      );
    }

    fileInput.value = "";
    focusInput();
  });

  avatar.onerror = () => {
    console.error("Nu s-a putut încărca avatarul:", avatar.src);
  };

  avatar.onload = () => {
    if (!avatarFrame.style.left) {
      placeAvatar(innerWidth * 0.35, innerHeight * 0.25);
    }
  };

  addEventListener("resize", () => {
    placeAvatar(
      parseFloat(avatarFrame.style.left) || 0,
      parseFloat(avatarFrame.style.top) || 0
    );
  });

  setInterval(moveRandomly, 3500);
  focusInput();
})();
