        'breezevpn.com',
        'www.bangkokpost.com'
    ];

    // Modul 3: schimbă selectiv fundalurile deschise pentru aceste domenii.
    const MODE_3_HOSTS = [
        'www.libertatea.ro',
        'www.allergyzen.ro',
        'www.polti.ro',
        'www.patulmeu.ro',
        'www.agrinin.ro',
        'www.plaiurimioritice.ro',
