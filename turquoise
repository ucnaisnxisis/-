    ];

    const MODE_2_CSS = `
        :root {
            color-scheme: dark !important;
            background: ${TURQUOISE} !important;
            color: #e6f5f4 !important;
        }

        html, body {
            background: ${TURQUOISE} !important;
            background-color: ${TURQUOISE} !important;
            color: #e6f5f4 !important;
        }

        body * {
            border-color: #436b69 !important;
        }

        body :not(img):not(video):not(canvas):not(iframe):not(svg):not(path) {
            color: #e6f5f4 !important;
            background-color: transparent !important;
        }

        body, main, article, section, header, footer, nav, aside,
        [role="main"], [role="dialog"], .container, .content, .card,
        .panel, .modal, .dropdown-menu, .popover {
            background-color: #103b3a !important;
        }

        input, textarea, select, button {
            background: #194d4b !important;
            color: #effafa !important;
            border: 1px solid #578782 !important;
        }

        input::placeholder, textarea::placeholder {
            color: #b3d0ce !important;
        }

        a, a * {
            color: #7fe8df !important;
        }

        img, video, canvas, iframe, svg, picture {
            background-color: transparent !important;
        }

        table, th, td, hr {
            border-color: #436b69 !important;
        }

        ::selection {
            background: #287a75 !important;
            color: #fff !important;
        }
    `;

    // Modul 5: paletă turcoaz pentru Archive.org și Shadow Root-uri deschise.
    const MODE_5_CSS = `
        :host {
            color-scheme: dark !important;
            background-color: ${MODE_5_BACKGROUND} !important;
            color: #e6f5f4 !important;
        }

        :host(*) {
            color: #e6f5f4 !important;
            border-color: #436b69 !important;
        }

        :host,
        :host(*) {
            background-color: ${MODE_5_BACKGROUND} !important;
        }

        *:not(img):not(video):not(canvas):not(iframe):not(svg):not(path):not(picture) {
            background-color: ${MODE_5_BACKGROUND} !important;
            color: #e6f5f4 !important;
            border-color: #436b69 !important;
        }

        a,
        a * {
            color: #7fe8df !important;
        }

        input,
        textarea,
        select,
        button {
            background-color: #194d4b !important;
            color: #effafa !important;
            border-color: #578782 !important;
        }

        input::placeholder,
        textarea::placeholder {
            color: #b3d0ce !important;
            opacity: 1 !important;
        }

        img,
        video,
        canvas,
        iframe,
        svg,
        picture {
            background-color: transparent !important;
        }

        ::selection {
            background: #287a75 !important;
            color: #ffffff !important;
        }
    `;

    function isLightBackground(color) {
        const values = color.match(/[\d.]+/g);
        if (!values || values.length < 3) return false;

        const [r, g, b] = values.slice(0, 3).map(Number);
        const alpha = values.length >= 4 ? Number(values[3]) : 1;

        if (alpha < 0.15) return false;

        return (0.2126 * r + 0.7152 * g + 0.0722 * b) > 155;
    }

    function isMediaOrInsideMedia(el) {
        return el.matches(
            'img, video, canvas, picture, svg, iframe, object, embed'
        ) || Boolean(el.closest(
            'img, video, canvas, picture, svg, iframe, object, embed'
        ));
    }

    function colorLightBackground(el) {
        if (!(el instanceof Element) || el.hasAttribute(MARK)) return;
        if (isMediaOrInsideMedia(el)) return;

        if (isLightBackground(getComputedStyle(el).backgroundColor)) {
            originalBackgrounds.set(el, {
                value: el.style.getPropertyValue('background-color'),
                priority: el.style.getPropertyPriority('background-color')
            });

            el.setAttribute(MARK, '1');
            el.style.setProperty('background-color', TURQUOISE, 'important');
        }
    }

    function scan(root) {
        if (root instanceof Element) {
            colorLightBackground(root);
        }

        root.querySelectorAll?.('*').forEach(colorLightBackground);
    }

    function clearMode3Marks() {
        document.querySelectorAll(`[${MARK}]`).forEach(el => {
            const original = originalBackgrounds.get(el);

            if (original?.value) {
                el.style.setProperty(
                    'background-color',
                    original.value,
                    original.priority
                );
            } else {
                el.style.removeProperty('background-color');
            }

            originalBackgrounds.delete(el);
            el.removeAttribute(MARK);
        });
    }

    function installMode5Style(root, id) {
        if (!root || root.querySelector(`#${id}`)) return;

        const style = document.createElement('style');
        style.id = id;
        style.textContent = MODE_5_CSS;

        if (root instanceof Document) {
            (root.head || root.documentElement)?.appendChild(style);
        } else {
            root.appendChild(style);
        }
    }

    function installMode5InShadowRoot(root) {
        if (isMode5 && root) {
            installMode5Style(root, 'tm-turquoise-mode-5-archive-shadow');
        }
    }

    function scanMode5ShadowRoots(root) {
        if (!isMode5 || !root) return;

        if (root instanceof Element && root.shadowRoot) {
            installMode5InShadowRoot(root.shadowRoot);
            scanMode5ShadowRoots(root.shadowRoot);
        }

        if (root instanceof ShadowRoot) {
            installMode5InShadowRoot(root);
        }

        root.querySelectorAll?.('*').forEach(element => {
            if (element.shadowRoot) {
                installMode5InShadowRoot(element.shadowRoot);
                scanMode5ShadowRoots(element.shadowRoot);
            }
        });
    }

    function startMode5() {
        installMode5Style(
            document,
            'tm-turquoise-mode-5-archive-document'
        );

        scanMode5ShadowRoots(document);

        const observer = new MutationObserver(records => {
            for (const record of records) {
                for (const node of record.addedNodes) {
                    if (node.nodeType === Node.ELEMENT_NODE) {
                        scanMode5ShadowRoots(node);
                    }
                }
            }
        });

        function observeDocument() {
            if (document.documentElement) {
                observer.observe(document.documentElement, {
                    childList: true,
                    subtree: true
                });
            }
        }

        if (document.documentElement) {
            observeDocument();
        } else {
            document.addEventListener('DOMContentLoaded', () => {
                installMode5Style(
                    document,
                    'tm-turquoise-mode-5-archive-document'
                );
                scanMode5ShadowRoots(document);
                observeDocument();
            }, { once: true });
        }
    }

    // Aplică stilul imediat în Shadow Root-urile deschise create ulterior.
    if (isMode5 && Element.prototype.attachShadow) {
        const originalAttachShadow = Element.prototype.attachShadow;

        Element.prototype.attachShadow = function(init) {
            const shadowRoot = originalAttachShadow.call(this, init);

            if (init && init.mode === 'open') {
                installMode5InShadowRoot(shadowRoot);
            }

            return shadowRoot;
        };
    }

    function applyMode() {
        // Modul 5 are prioritate pentru archive.org.
        if (isMode5) {
            startMode5();
            return;
        }

        const useMode2 = matchesHost(MODE_2_HOSTS);
        const useMode3 = !useMode2 && matchesHost(MODE_3_HOSTS);

        if (useMode2) {
            const style = document.createElement('style');
            style.id = 'tm-aggressive-turquoise-mode';
            style.textContent = MODE_2_CSS;

            (document.head || document.documentElement).appendChild(style);

            const observer = new MutationObserver(() => {
                if (!document.getElementById('tm-aggressive-turquoise-mode')) {
                    (document.head || document.documentElement)
                        .appendChild(style);
                }
            });

            observer.observe(document.documentElement, {
                childList: true,
                subtree: true
            });

            return;
        }

        if (useMode3) {
            scan(document.documentElement);

            const observer = new MutationObserver(records => {
                for (const record of records) {
                    for (const node of record.addedNodes) {
                        if (node.nodeType === Node.ELEMENT_NODE) {
                            scan(node);
                        }
                    }
                }
            });

            observer.observe(document.documentElement, {
                childList: true,
                subtree: true
            });

            return;
        }

        // Modul 1: tema implicită pentru toate celelalte site-uri.
        DarkReader.enable(THEME);
    }

    if (document.documentElement) {
        applyMode();
    } else {
        document.addEventListener('DOMContentLoaded', applyMode, {
            once: true
        });
    }
})();
