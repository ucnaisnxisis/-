// ==UserScript==
// @name         Avertizare site 18+ cu audio și GIF
// @homepage     https://raw.githubusercontent.com/ucnaisnxisis/-/refs/heads/main/fk
// @namespace    local
// @version      2.0
// @description  Afișează un avertisment temporar pe paginile recunoscute ca 18+
// @match        *://*/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(() => {
    'use strict';

    const AUDIO_URL =
        'https://ia600706.us.archive.org/32/items/its-time-to-stop_20261124/its%20time%20to%20stop.mp3';

    const GIF_URL =
        'https://ia600706.us.archive.org/32/items/its-time-to-stop_20261124/fff.gif';

    // Pornește doar dacă adresa sau titlul paginii conține unul dintre acești termeni.
    const textPagina = `${location.hostname} ${document.title}`.toLowerCase();
    const site18Plus =
        /\b(porn|porno|pornography|xamster|xshamster|xtube|xpee|xxx|ixx|pinktube|redtube|xnxx|xvideo|xvideos|pee|ass|pussy|dick|smell|ejaculation|ejaculated|ejaculare|ejaculari|adult|sex)\b|18\+/i.test(textPagina);

    if (!site18Plus) return;

    const overlay = document.createElement('div');
    overlay.style.cssText = `
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 16px;
        background: rgba(180, 0, 0, 0.92);
        text-align: center;
        overflow: auto;
    `;

    const imagine = document.createElement('img');
    imagine.src = GIF_URL;
    imagine.alt = 'Avertisment';
    imagine.style.cssText = `
        max-width: min(80vw, 360px);
        max-height: 55vh;
        object-fit: contain;
        transform: scale(3);
        transform-origin: center;
    `;

    const audio = new Audio(AUDIO_URL);
    audio.preload = 'auto';

    const buton = document.createElement('button');
    buton.textContent = 'Pornește audio';
    buton.style.cssText = 'padding: 10px 16px; font-size: 16px;';

    overlay.append(imagine, buton);
    document.documentElement.appendChild(overlay);

    let terminat = false;
    let timerId;

    function inchide() {
        if (terminat) return;

        terminat = true;
        clearTimeout(timerId);
        audio.pause();
        overlay.remove();
    }

    // Închide overlay-ul după 10 secunde, chiar dacă audio-ul sau GIF-ul nu funcționează.
    timerId = setTimeout(inchide, 10_000);

    // Închide și când audio-ul ajunge la final.
    audio.addEventListener('timeupdate', () => {
        if (
            Number.isFinite(audio.duration) &&
            audio.duration - audio.currentTime <= 0.5
        ) {
            inchide();
        }
    });

    audio.addEventListener('ended', inchide, { once: true });

    buton.addEventListener('click', () => {
        audio.play()
            .then(() => buton.remove())
            .catch(() => {
                buton.textContent = 'Redarea nu a pornit — încearcă din nou';
            });
    });

    // Încearcă redarea automată; unele browsere cer un clic înainte.
    audio.play()
        .then(() => buton.remove())
        .catch(() => {
            buton.hidden = false;
        });
})();
