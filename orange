        'www.accuweather.com',
        'www.meteoblue.com',
        'meteofor.ro',
        'ziare.com',
        'www.biziday.ro',
        'newsweek.ro',
        'www.ziuanews.ro',
        'www.capital.ro',
        'www.e-politic.ro',
        'video.mediafax.ro',
        'www.xda-developers.com',
        'orchard.tomathouse.com',
