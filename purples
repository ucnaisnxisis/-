    // Modul 5: reguli aplicate în document și în fiecare Shadow Root deschis.
    const MODE_5_CSS = `
        :host {
            color-scheme: dark !important;
            background-color: ${MODE_5_BACKGROUND} !important;
            color: #eee6f5 !important;
        }

        :host(*) {
