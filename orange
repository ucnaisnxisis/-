// ==UserScript==
// @name         Orange Mode automat — 4 moduri
// @namespace    local.orangemode
// @version      5.0.0
// @description  Alege automat tema portocalie în funcție de site.
// @match        *://*/*
// @run-at       document-start
// @grant        none
// @require      https://cdn.jsdelivr.net/npm/darkreader@4.9.96/darkreader.min.js
// ==/UserScript==

(() => {
    'use strict';

    const MARK = 'data-tm-orange-bg';
    const originalBackgrounds = new Map();

    const ORANGE = '#ff8c00';
    const MODE_5_BACKGROUND = '#3b2810';

    // Modul 1: DarkReader pentru site-urile care nu apar în listele speciale.
    const THEME = {
        mode: 1,
        brightness: 100,
        contrast: 80,
        sepia: 0,
        darkSchemeBackgroundColor: ORANGE,
        darkSchemeTextColor: '#ffffff',
        lightSchemeBackgroundColor: ORANGE,
        lightSchemeTextColor: '#ffd28a'
    };

    const host = location.hostname.toLowerCase();

    function normalizeHost(value) {
        return value.toLowerCase().replace(/^www\./, '');
    }

    function matchesHost(domains) {
        const currentHost = normalizeHost(host);

        return domains.some(domain => {
            const normalizedDomain = normalizeHost(domain);

            return currentHost === normalizedDomain ||
                currentHost.endsWith('.' + normalizedDomain);
        });
    }

    const isMode5 = matchesHost([
        'archive.org',
        'www.archive.org'
    ]);

    // Modul 2: stil portocaliu aplicat agresiv acestor domenii.
    const MODE_2_HOSTS = [
