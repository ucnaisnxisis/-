        'checkip.me',
        'ipaddress.to',
        'whatsmyip.net',
        'myip-address.com',
        'whatismyip.live',
        'www.virustotal.com',
        'github.com',
        'proton.me',
        'proton.com',
        'www.pewresearch.org',
        'breezevpn.com',
        'www.bangkokpost.com'
    ];

    // Modul 3: schimbă selectiv fundalurile deschise pentru aceste domenii.
    const MODE_3_HOSTS = [
        'www.libertatea.ro',
        'www.allergyzen.ro',
        'www.polti.ro',
        'www.patulmeu.ro',
        'www.agrinin.ro',
