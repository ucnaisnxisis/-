// ==UserScript==
// @name         Pink Mode automat — 3 moduri
// @namespace    local.pinkmode
// @version      4.1.0
// @description  Alege automat tema roz în funcție de site.
// @match        *://*/*
// @run-at       document-start
// @grant        none
// @require      https://cdn.jsdelivr.net/npm/darkreader@4.9.96/darkreader.min.js
// ==/UserScript==

(() => {
    'use strict';

    const MARK = 'data-tm-pink-bg';
    const originalBackgrounds = new Map();

    const PINK = '#c71585';

    // Modul 1: DarkReader pentru site-urile care nu apar în listele speciale.
    const THEME = {
        mode: 1,
        brightness: 100,
        contrast: 80,
        sepia: 0,
        darkSchemeBackgroundColor: PINK,
        darkSchemeTextColor: '#ffffff',
        lightSchemeBackgroundColor: PINK,
        lightSchemeTextColor: '#ff9ad5'
    };

    // Modul 2: stil roz aplicat agresiv acestor domenii.
    const MODE_2_HOSTS = [
        'porngameshub.com',
        'itch.io',
        'www.xvideos.com',
        'hanime.tv',
        'hentaihaven.xxx',
        'henvids.com',
        'hentaiocean.com',
        'e-hentai.org',
        'hanime.red',
        'www.fakku.net',
        'hstream.moe',
        'hentai2read.com',
        'hentai.guru',
        'www.hentai-foundry.com',
        'myanimelist.net',
        'haho.moe',
        'hentai.io',
        'www.porn.com',
        'www.porndig.com',
        'hentaihorizon.com',
        'www.tiava.com',
        'www.accuweather.com',
        'www.meteoblue.com',
        'meteofor.ro',
        'ziare.com',
        'www.biziday.ro',
        'newsweek.ro',
        'www.ziuanews.ro',
        'www.capital.ro',
        'www.e-politic.ro',
        'video.mediafax.ro',
        'www.xda-developers.com',
        'orchard.tomathouse.com',
        'www.emag.ro',
        'www.marcoser.ro',
        'www.libertatea.ro',
        'ipinfo.io',
        '2ip.io',
        'ipmeu.ro',
        'checkip.me',
        'ipaddress.to',
        'whatsmyip.net',
        'myip-address.com',
        'whatismyip.live',
        'github.com',
        'proton.me',
        'proton.com',
        'www.pewresearch.org',
        'breezevpn.com',
        'www.bangkokpost.com',

    ];

    // Modul 3: schimbă selectiv fundalurile deschise pentru aceste domenii.
    const MODE_3_HOSTS = [
        'www.libertatea.ro',
        'www.allergyzen.ro',
        'www.polti.ro',
        'www.patulmeu.ro',
        'www.agrinin.ro',
        'www.plaiurimioritice.ro',
        'www.academia.edu',
        'www.cel.ro',
    ];

    const MODE_2_CSS = `
        :root {
            color-scheme: dark !important;
            background: ${PINK} !important;
            color: #f5e6ef !important;
        }

        html, body {
            background: ${PINK} !important;
            background-color: ${PINK} !important;
            color: #f5e6ef !important;
        }

        body * {
            border-color: #70435c !important;
        }

        body :not(img):not(video):not(canvas):not(iframe):not(svg):not(path) {
            color: #f5e6ef !important;
            background-color: transparent !important;
        }

        body, main, article, section, header, footer, nav, aside,
        [role="main"], [role="dialog"], .container, .content, .card,
        .panel, .modal, .dropdown-menu, .popover {
            background-color: #3b102b !important;
        }

        input, textarea, select, button {
            background: #4d1938 !important;
            color: #faf0f6 !important;
            border: 1px solid #87576f !important;
        }

        input::placeholder, textarea::placeholder {
            color: #d0b3c3 !important;
        }

        a, a * {
            color: #ff9ad5 !important;
        }

        img, video, canvas, iframe, svg, picture {
            background-color: transparent !important;
        }

        table, th, td, hr {
            border-color: #70435c !important;
        }

        ::selection {
            background: #8a3068 !important;
            color: #fff !important;
        }
    `;

    const host = location.hostname.toLowerCase();

    function matchesHost(domains) {
        const normalize = value => value.toLowerCase().replace(/^www\./, '');
        const currentHost = normalize(host);

        return domains.some(domain => {
            const normalizedDomain = normalize(domain);
            return currentHost === normalizedDomain ||
                currentHost.endsWith('.' + normalizedDomain);
        });
    }

    function isLightBackground(color) {
        const values = color.match(/[\\d.]+/g);
        if (!values || values.length < 3) return false;

        const [r, g, b] = values.slice(0, 3).map(Number);
        const alpha = values.length >= 4 ? Number(values[3]) : 1;

        if (alpha < 0.15) return false;

        return (0.2126 * r + 0.7152 * g + 0.0722 * b) > 155;
    }

    function isMediaOrInsideMedia(el) {
        return el.matches(
            'img, video, canvas, picture, svg, iframe, object, embed'
        ) || Boolean(el.closest(
            'img, video, canvas, picture, svg, iframe, object, embed'
        ));
    }

    function colorLightBackground(el) {
        if (!(el instanceof Element) || el.hasAttribute(MARK)) return;
        if (isMediaOrInsideMedia(el)) return;

        if (isLightBackground(getComputedStyle(el).backgroundColor)) {
            originalBackgrounds.set(el, {
                value: el.style.getPropertyValue('background-color'),
                priority: el.style.getPropertyPriority('background-color')
            });

            el.setAttribute(MARK, '1');
            el.style.setProperty('background-color', PINK, 'important');
        }
    }

    function scan(root) {
        if (root instanceof Element) {
            colorLightBackground(root);
        }

        root.querySelectorAll?.('*').forEach(colorLightBackground);
    }

    function clearMode3Marks() {
        document.querySelectorAll(`[${MARK}]`).forEach(el => {
            const original = originalBackgrounds.get(el);

            if (original?.value) {
                el.style.setProperty(
                    'background-color',
                    original.value,
                    original.priority
                );
            } else {
                el.style.removeProperty('background-color');
            }

            originalBackgrounds.delete(el);
            el.removeAttribute(MARK);
        });
    }

    function applyMode() {
        const useMode2 = matchesHost(MODE_2_HOSTS);
        const useMode3 = !useMode2 && matchesHost(MODE_3_HOSTS);

        if (useMode2) {
            const style = document.createElement('style');
            style.id = 'tm-aggressive-pink-mode';
            style.textContent = MODE_2_CSS;

            (document.head || document.documentElement).appendChild(style);

            const observer = new MutationObserver(() => {
                if (!document.getElementById('tm-aggressive-pink-mode')) {
                    (document.head || document.documentElement).appendChild(style);
                }
            });

            observer.observe(document.documentElement, {
                childList: true,
                subtree: true
            });

            return;
        }

        if (useMode3) {
            scan(document.documentElement);

            const observer = new MutationObserver(records => {
                for (const record of records) {
                    for (const node of record.addedNodes) {
                        if (node.nodeType === Node.ELEMENT_NODE) {
                            scan(node);
                        }
                    }
                }
            });

            observer.observe(document.documentElement, {
                childList: true,
                subtree: true
            });

            return;
        }

        // Modul 1: tema implicită pentru toate celelalte site-uri.
        DarkReader.enable(THEME);
    }

    if (document.documentElement) {
        applyMode();
    } else {
        document.addEventListener('DOMContentLoaded', applyMode, { once: true });
    }
})();
