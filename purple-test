        }

        input::placeholder,
        textarea::placeholder {
            color: #e0d2ed !important;
            opacity: 1 !important;
        }

        img,
        video,
        canvas,
        iframe,
        svg,
        picture {
            background-color: transparent !important;
        }

        ::selection {
            background: #8b65b0 !important;
            color: #ffffff !important;
        }
    `;

    function installStyle(target, id, css) {
        if (!target || target.querySelector(`#${id}`)) return;

        const style = document.createElement('style');
        style.id = id;
        style.textContent = css;
        target.appendChild(style);
    }

    function installPersistentStyle(id, css) {
        function addStyle() {
            if (document.getElementById(id)) return;

            const style = document.createElement('style');
            style.id = id;
            style.textContent = css;

            (document.head || document.documentElement)?.appendChild(style);
        }

        addStyle();

        const observer = new MutationObserver(addStyle);
        observer.observe(document.documentElement, {
            childList: true,
            subtree: true
        });
    }

    function installMode5InRoot(root) {
        if (!isMode5 || !root) return;

        installStyle(
            root,
            'tm-purple-mode-5-archive-shadow',
            MODE_5_CSS
        );
    }

    function scanOpenShadowRoots(root) {
        if (!isMode5 || !root) return;

        if (root instanceof Element && root.shadowRoot) {
            installMode5InRoot(root.shadowRoot);
            scanOpenShadowRoots(root.shadowRoot);
        }

        if (root instanceof ShadowRoot) {
            installMode5InRoot(root);
        }

        root.querySelectorAll?.('*').forEach(element => {
            if (element.shadowRoot) {
                installMode5InRoot(element.shadowRoot);
                scanOpenShadowRoots(element.shadowRoot);
            }
        });
    }

    function startMode5() {
        installStyle(
            document,
            'tm-purple-mode-5-archive-document',
            MODE_5_CSS
        );

        scanOpenShadowRoots(document);

        const observer = new MutationObserver(records => {
            for (const record of records) {
                for (const node of record.addedNodes) {
                    if (node.nodeType === Node.ELEMENT_NODE) {
                        scanOpenShadowRoots(node);
                    }
                }
            }
        });

        if (document.documentElement) {
            observer.observe(document.documentElement, {
                childList: true,
                subtree: true
            });
        } else {
            document.addEventListener('DOMContentLoaded', () => {
                installStyle(
                    document,
                    'tm-purple-mode-5-archive-document',
                    MODE_5_CSS
                );

                scanOpenShadowRoots(document);

                observer.observe(document.documentElement, {
                    childList: true,
                    subtree: true
                });
            }, { once: true });
        }
    }

    if (isMode5 && Element.prototype.attachShadow) {
        const originalAttachShadow = Element.prototype.attachShadow;

        Element.prototype.attachShadow = function(init) {
            const shadowRoot = originalAttachShadow.call(this, init);

            if (init && init.mode === 'open') {
                installMode5InRoot(shadowRoot);
            }

            return shadowRoot;
        };
    }

    function isLightBackground(color) {
        const values = color.match(/[\d.]+/g);
        if (!values || values.length < 3) return false;

        const [r, g, b] = values.slice(0, 3).map(Number);
        const alpha = values.length >= 4 ? Number(values[3]) : 1;

        if (alpha < 0.15) return false;

        return (0.2126 * r + 0.7152 * g + 0.0722 * b) > 155;
    }

    function isMediaOrInsideMedia(el) {
        return el.matches(
            'img, video, canvas, picture, svg, iframe, object, embed'
        ) || Boolean(el.closest(
            'img, video, canvas, picture, svg, iframe, object, embed'
        ));
    }

    const MARK = 'data-tm-purple-bg';
    const MODE_4_MARK = 'data-tm-purple-mode-4-bg';

    function colorLightBackground(el) {
        if (!(el instanceof Element) || el.hasAttribute(MARK)) return;
        if (isMediaOrInsideMedia(el)) return;

        if (isLightBackground(getComputedStyle(el).backgroundColor)) {
            el.setAttribute(MARK, '1');
            el.style.setProperty('background-color', PURPLE, 'important');
        }
    }

    function scan(root) {
        if (root instanceof Element) colorLightBackground(root);
        root.querySelectorAll?.('*').forEach(colorLightBackground);
    }

    function colorMode4LightBackground(el) {
        if (!(el instanceof Element) || el.hasAttribute(MODE_4_MARK)) return;
        if (isMediaOrInsideMedia(el)) return;

        if (isLightBackground(getComputedStyle(el).backgroundColor)) {
            el.setAttribute(MODE_4_MARK, '1');
            el.style.setProperty('background-color', PURPLE, 'important');
        }
    }

    function scanMode4(root) {
        if (root instanceof Element) colorMode4LightBackground(root);
        root.querySelectorAll?.('*').forEach(colorMode4LightBackground);
    }

    function startMode4() {
        installPersistentStyle(
            'tm-purple-mode-4-stiripesurse',
            MODE_4_CSS
        );

        scanMode4(document.documentElement);

        const observer = new MutationObserver(records => {
            for (const record of records) {
                if (record.type === 'childList') {
                    for (const node of record.addedNodes) {
                        if (node.nodeType === Node.ELEMENT_NODE) {
                            scanMode4(node);
                        }
                    }
                } else if (
                    record.type === 'attributes' &&
                    record.target instanceof Element
                ) {
                    colorMode4LightBackground(record.target);
                }
            }
        });

        observer.observe(document.documentElement, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class', 'style']
        });
    }

    function applyMode() {
        const useMode5 = isMode5;
        const useMode4 = !useMode5 && matchesHost(MODE_4_HOSTS);
        const useMode2 = !useMode5 && !useMode4 &&
            matchesHost(MODE_2_HOSTS);
        const useMode3 = !useMode5 && !useMode4 && !useMode2 &&
            matchesHost(MODE_3_HOSTS);

        if (useMode5) {
            startMode5();
            return;
        }

        if (useMode4) {
            startMode4();
            return;
        }

        if (useMode2) {
            installPersistentStyle(
                'tm-aggressive-purple-mode',
                MODE_2_CSS
            );
            return;
        }

        if (useMode3) {
            installPersistentStyle(
                'tm-purple-mode-3',
                MODE_3_CSS
            );

            scan(document.documentElement);

            const observer = new MutationObserver(records => {
                for (const record of records) {
                    for (const node of record.addedNodes) {
                        if (node.nodeType === Node.ELEMENT_NODE) {
                            scan(node);
                        }
                    }
                }
            });

            observer.observe(document.documentElement, {
                childList: true,
                subtree: true
            });

            return;
        }

        DarkReader.enable(THEME);
    }

    if (document.documentElement) {
        applyMode();
    } else {
        document.addEventListener('DOMContentLoaded', applyMode, {
            once: true
        });
    }
