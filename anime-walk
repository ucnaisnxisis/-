// ==UserScript==
// @name         Anime Walkers — Search Overlay
// @homepage     https://raw.githubusercontent.com/ucnaisnxisis/-/refs/heads/main/anime-walk
// @namespace    local
// @version      4.5
// @description  Personaje anime și bule roz animate pe motoare de căutare
// @include      /^https:\/\/(www\.)?google\.[^/]+\/.*/
// @match        https://www.bing.com/*
// @match        https://duckduckgo.com/*
// @match        https://*.duckduckgo.com/*
// @match        https://noai.duckduckgo.com/*
// @match        https://search.brave.com/*
// @match        https://www.ecosia.org/*
// @match        https://startpage.com/*
// @match        https://www.startpage.com/*
// @match        https://*.startpage.com/*
// @resource     animePink https://media.tenor.com/qKcQ1JXcmPsAAAAj/pink-anime-pink-anime-girl.gif
// @resource     animeSecond https://img1.picmix.com/output/stamp/normal/3/4/9/7/1997943_57e8b.gif
// @run-at       document-idle
// @grant        GM_getResourceURL
// ==/UserScript==

(() => {
  if (!document.body || document.getElementById("anime-walk-overlay")) return;

  const characters = [
    GM_getResourceURL("animePink"),
    GM_getResourceURL("animeSecond")
  ];

  if (characters.some(src => !src)) {
    console.error("Anime Walkers: Tampermonkey nu a putut încărca resursele GIF.");
    return;
  }

  const host = document.createElement("div");
  host.id = "anime-walk-overlay";

  const shadow = host.attachShadow({ mode: "open" });

  const style = document.createElement("style");
  style.textContent = `
    :host {
      all: initial;
      position: fixed;
      inset: 0;
      display: block;
      overflow: hidden;
      z-index: 2147483647;
      pointer-events: none;
    }

    #stage {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .anime-walker {
      position: absolute;
      display: block;
      width: clamp(270px, 39vw, 540px);
      height: auto;
      object-fit: contain;
      transition: left 3.8s ease-in-out, top 3.8s ease-in-out,
                  transform .35s ease;
      filter: drop-shadow(0 4px 5px #0004);
      will-change: left, top, transform;
      user-select: none;
      -webkit-user-drag: none;
    }

    .anime-walker.pink-girl {
      width: min(90vw, 1400px);
    }

    .pink-bubble {
      position: absolute;
      width: 22px;
      height: 22px;
      border: 1px solid rgba(255,255,255,.85);
      border-radius: 50%;
      background:
        radial-gradient(circle at 30% 25%, #ffffff 0 8%, #ffffff8c 10% 17%, transparent 20%),
        radial-gradient(circle at 65% 70%, #ff69c8a6, #ffaadd52 55%, #ffffffc7);
      box-shadow: inset -3px -4px 7px #ff46b859, 0 0 9px #ff50be8c;
      animation: bubble-float-pop 1.25s ease-out forwards;
    }

    .pink-particle {
      position: absolute;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 25%, #fff, #ff72c8 60%, #ed36a6);
      box-shadow: 0 0 7px #ff72c8;
      animation: particle-burst .55s ease-out forwards;
    }

    @keyframes bubble-float-pop {
      0%   { opacity: 0; transform: scale(.35); }
      15%  { opacity: 1; transform: scale(1); }
      75%  { opacity: 1; transform: translate(10px,-14px) scale(1.08); }
      100% { opacity: 0; transform: translate(14px,-18px) scale(1.45); }
    }

    @keyframes particle-burst {
      from { opacity: 1; transform: translate(0,0) scale(1); }
      to {
        opacity: 0;
        transform: translate(var(--dx),var(--dy)) scale(.25);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .anime-walker { transition-duration: 8s; }
    }
  `;

  const stage = document.createElement("div");
  stage.id = "stage";

  shadow.append(style, stage);
  document.body.appendChild(host);

  const walkers = characters.map((src, index) => {
    const img = document.createElement("img");
    img.className = index === 0 ? "anime-walker pink-girl" : "anime-walker";
    img.alt = "";
    img.draggable = false;
    img.style.left = `${Math.round(innerWidth * (0.08 + index * 0.38))}px`;
    img.style.top = `${Math.round(innerHeight * (0.12 + index * 0.30))}px`;

    img.addEventListener("error", () => {
      console.error("Anime Walkers: GIF-ul-resursă nu s-a încărcat:", index + 1);
    });

    img.src = src;
    stage.appendChild(img);
    return img;
  });

  function moveRandomly(img) {
    if (!img.isConnected) return;

    const maxX = Math.max(0, innerWidth - img.offsetWidth);
    const maxY = Math.max(0, innerHeight - img.offsetHeight);
    const oldX = parseFloat(img.style.left) || 0;
    const newX = Math.random() * maxX;

    img.style.transform = newX < oldX ? "scaleX(-1)" : "scaleX(1)";
    img.style.left = `${newX}px`;
    img.style.top = `${Math.random() * maxY}px`;
  }

  function makePinkEffect(img) {
    if (!img.isConnected) return;

    const rect = img.getBoundingClientRect();
    const bubble = document.createElement("span");
    bubble.className = "pink-bubble";
    bubble.style.left = `${rect.left + rect.width * 0.25}px`;
    bubble.style.top = `${rect.top + rect.height * 0.72}px`;
    stage.appendChild(bubble);

    bubble.addEventListener("animationend", () => {
      const rect = bubble.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      bubble.remove();

      for (let i = 0; i < 7; i++) {
        const particle = document.createElement("span");
        particle.className = "pink-particle";
        particle.style.left = `${centerX}px`;
        particle.style.top = `${centerY}px`;
        particle.style.setProperty("--dx", `${(Math.random() - 0.5) * 54}px`);
        particle.style.setProperty("--dy", `${(Math.random() - 0.5) * 54}px`);
        stage.appendChild(particle);

        particle.addEventListener(
          "animationend",
          () => particle.remove(),
          { once: true }
        );
      }
    }, { once: true });
  }

  walkers.forEach((img, index) => {
    function wander() {
      moveRandomly(img);
      setTimeout(wander, 2500 + Math.random() * 3500);
    }

    function gag() {
      makePinkEffect(img);
      setTimeout(gag, 1800 + Math.random() * 2500);
    }

    setTimeout(wander, index * 900);
    setTimeout(gag, 1200 + index * 1000);
  });

  addEventListener("resize", () => {
    walkers.forEach(img => moveRandomly(img));
  });
})();
